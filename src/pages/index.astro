---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { SECTIONS, SECTION_KEYS } from '../consts';
import { getPosts } from '../lib/posts';

const recent = (await getPosts()).slice(0, 8);
---
<Base>
  <h1>TODO: home heading</h1>
  <p>TODO: short intro, two or three sentences about who you are and what you write about.</p>

  <div class="areas">
    {SECTION_KEYS.map((key) => (
      <a href={`/${key}`}>
        <strong>{SECTIONS[key].title}</strong>
        <span class="muted">{SECTIONS[key].blurb}</span>
      </a>
    ))}
  </div>

  <h2>Recent posts</h2>
  <PostList posts={recent} />
</Base>
