---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { TAGS, type Tag } from '../../content.config';
import { getPosts } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  // Only tags that have at least one published post get a page.
  return TAGS.filter((tag) => posts.some((p) => p.data.tags.includes(tag))).map((tag) => ({
    params: { tag },
    props: { posts: posts.filter((p) => p.data.tags.includes(tag)) },
  }));
}

const tag = Astro.params.tag as Tag;
const { posts } = Astro.props;
---
<Base title={`#${tag}`} description={`Posts tagged ${tag}`}>
  <h1>#{tag}</h1>
  <PostList posts={posts} />
  <p class="ui"><a href="/tags">All tags</a></p>
</Base>
