---
import Base from '../../layouts/Base.astro';
import { TAGS } from '../../content.config';
import { getPosts } from '../../lib/posts';

const posts = await getPosts();
const counts = TAGS.map((tag) => ({ tag, n: posts.filter((p) => p.data.tags.includes(tag)).length })).filter(
  (t) => t.n > 0,
);
---
<Base title="Tags" description="All tags">
  <h1>Tags</h1>
  {counts.length === 0 ? (
    <p class="muted">No tags yet.</p>
  ) : (
    <ul class="tags">
      {counts.map(({ tag, n }) => <li><a href={`/tags/${tag}`}>#{tag} ({n})</a></li>)}
    </ul>
  )}
</Base>
